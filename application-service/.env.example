# Application Service Environment Configuration

# Application Settings
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8001

# IMPORTANT: Must match main monolith SECRET_KEY for JWT validation
SECRET_KEY=your-secret-key-must-match-monolith

# Database - Shared with main monolith during transition
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=risktrix_user
POSTGRES_PASSWORD=risktrix_password
POSTGRES_DB=risktrix_db

# Redis
REDIS_URL=redis://localhost:6379

# File Uploads
MAX_UPLOAD_SIZE=10485760
UPLOAD_FOLDER=uploads/poc

# Logging
LOG_LEVEL=INFO
