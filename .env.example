# RiskTrix Microservices - Environment Configuration
# Copy this file to .env and customize values for your environment
# WARNING: Never commit the actual .env file with real secrets

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=risktrix_db
# Async PostgreSQL connection URL
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/risktrix_db
# Sync PostgreSQL connection URL (if needed)
DATABASE_URL_SYNC=postgresql://postgres:password@postgres:5432/risktrix_db

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ============================================================================
# SERVICE PORTS
# ============================================================================
# Primary Services
CISODASHBOARD_BACKEND_PORT=8000
APPLICATION_SERVICE_PORT=8001
AUDIT_SERVICE_PORT=8002

# Microservices
ASSET_SERVICE_PORT=8003
TICKET_SERVICE_PORT=8004
DIRECTORY_SERVICE_PORT=8005
POLICY_SERVICE_PORT=8006
FILE_SERVICE_PORT=8007
NOTIFICATION_SERVICE_PORT=8008
QUEUE_SERVICE_PORT=8009
SEARCH_SERVICE_PORT=8010

# Frontend
FRONTEND_PORT=8888

# API Gateway
GATEWAY_PORT=8080

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# IMPORTANT: Change these in production!
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# ENVIRONMENT SETTINGS
# ============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
NODE_ENV=development
VITE_API_URL=http://localhost:8000
VITE_GATEWAY_URL=http://localhost:8080

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@risktrix.com

# ============================================================================
# ALEMBIC CONFIGURATION
# ============================================================================
# Database connection for migrations (typically same as DATABASE_URL_SYNC)
ALEMBIC_DATABASE_URL=postgresql://postgres:password@postgres:5432/risktrix_db

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS=["http://localhost:8888", "http://localhost:8000", "http://localhost:3000"]
CORS_CREDENTIALS=true
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
# Sentry Error Tracking (optional)
SENTRY_DSN=

# Application Performance Monitoring
APM_ENABLED=false
APM_SERVICE_NAME=risktrix

# ============================================================================
# EXTERNAL API INTEGRATIONS (Optional)
# ============================================================================
# Add external service credentials here as needed
# Example: GitHub API, Jira, Slack, etc.

# ============================================================================
# FEATURE FLAGS (Optional)
# ============================================================================
ENABLE_SCHEDULER=true
ENABLE_EVENT_BUS=true
ENABLE_FILE_UPLOADS=true
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================
# Enable debug mode (development only)
DEBUG=true

# Enable hot-reload for services
RELOAD=true

# Enable pytest coverage
PYTEST_COVERAGE=false

# ============================================================================
# TIMEZONE
# ============================================================================
TZ=UTC
